# Paragraph-chunked variant of the doc schema (Experiment 3).
# Chunks are pre-split on paragraph boundaries and fed as an array, instead of
# the blueprint's in-schema fixed-length 1024-char chunking. Everything else
# (embedder, features, ranking) matches the doc schema.
schema docp {

    document docp {

        field id type string {
            indexing: summary | attribute
        }

        field tenant type string {
            indexing: summary | attribute
            attribute: fast-search
        }

        field doc_type type string {
            indexing: summary | attribute
        }

        field title type string {
            indexing: index | summary
            index: enable-bm25
        }

        field chunks type array<string> {
            indexing: summary | index
            index: enable-bm25
        }

        field created_timestamp type long {
            indexing: attribute | summary
        }
        field modified_timestamp type long {
            indexing: attribute | summary
        }
        field last_opened_timestamp type long {
            indexing: attribute | summary
        }
        field open_count type int {
            indexing: attribute | summary
        }
        field favorite type bool {
            indexing: attribute | summary
        }

    }

    field title_embedding type tensor<int8>(x[96]) {
        indexing: input title | embed nomicmb | pack_bits | attribute | index
        attribute {
            distance-metric: hamming
        }
    }

    field chunk_embeddings type tensor<int8>(chunk{}, x[96]) {
        indexing: input chunks | embed nomicmb | pack_bits | attribute | index
        attribute {
            distance-metric: hamming
        }
    }

    fieldset default {
        fields: title, chunks
    }

    document-summary no-chunks {
        summary id {}
        summary tenant {}
        summary title {}
        summary created_timestamp {}
        summary modified_timestamp {}
        summary chunks {}
    }

    document-summary top_3_chunks {
        from-disk
        summary id {}
        summary tenant {}
        summary chunks_top3 {
            source: chunks
            select-elements-by: top_3_chunk_sim_scores
        }
    }
}
